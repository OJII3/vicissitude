  "label": {
    "addressee": { "kind": "character" },
    "expectedAction": "reply",
    "referencedMessageIds": ["m1", "m4"],
    "maxWaitMs": 25000,
    "misinterventionSeverity": "high",
    "notes": "サッカーの会話 (m2, m3, m5) は別クラスタ。そちらの話題を混ぜて返すのは誤介入。"
